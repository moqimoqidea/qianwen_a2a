# 千问模型 Responses 兼容接口。请替换为开放平台中实际分配的地址和密钥。
QWEN_API_URL=
QWEN_API_KEY=
QWEN_MODEL=qwen3.8-flash
QWEN_ENABLE_THINKING=true
QWEN_ENABLE_WEB_SEARCH=true
QWEN_REQUEST_TIMEOUT_SECONDS=120

# 必须是千问平台可以访问的公网 HTTPS 地址；本地联调时可填隧道地址。
A2A_PUBLIC_URL=http://127.0.0.1:8000
A2A_HOST=0.0.0.0
A2A_PORT=8000
A2A_RPC_PATH=/a2a
A2A_EVENT_CALLBACK_PATH=/agent/event/callback

# 可选验签。两项都留空时关闭；启用时必须同时填写。
QWEN_CLIENT_ID=
QWEN_CLIENT_SECRET=
QWEN_SIGNATURE_MAX_SKEW_SECONDS=300

LOG_LEVEL=INFO
